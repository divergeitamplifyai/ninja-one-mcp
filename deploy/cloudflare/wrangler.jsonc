// ninja-one-mcp on Cloudflare Containers. See docs/CLOUDFLARE.md.
//
// A Worker (src/worker.ts) fronts a container built from the repository's
// Dockerfile, the same image the Azure lane runs. Secrets are set with
// `wrangler secret put` and never live in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ninja-one-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",

  // workers.dev is fine to start. For a custom domain, set workers_dev to
  // false and add: "routes": [{ "pattern": "mcp.example.com", "custom_domain": true }]
  "workers_dev": true,
  "preview_urls": false,

  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "NinjaOneContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      // 1/4 vCPU, 1 GiB: the server idles at well under 100 MiB.
      "instance_type": "basic",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NINJAONE_MCP", "class_name": "NinjaOneContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NinjaOneContainer"] }],

  // Set with: wrangler secret put <NAME>
  //   NINJAONE_CLIENT_ID, NINJAONE_CLIENT_SECRET
  //   NINJAONE_HTTP_BEARER_TOKENS (bearer mode only)
  "secrets": { "required": ["NINJAONE_CLIENT_ID", "NINJAONE_CLIENT_SECRET"] },

  "vars": {
    // Container instances to spread requests over, and idle minutes before one sleeps.
    "CONTAINER_INSTANCES": "1",
    "CONTAINER_IDLE_MINUTES": "15",

    // NinjaOne. Same meaning as in the README. Read-only by default.
    "NINJAONE_REGION": "us",
    "NINJAONE_SCOPES": "monitoring",
    "NINJAONE_MODE": "read",
    "NINJAONE_ALLOW_DESTRUCTIVE": "false",
    "NINJAONE_ALLOWED_ORG_IDS": "",
    "NINJAONE_TOOLSETS": "default",

    // Inbound auth: entra (recommended) or bearer. The Worker refuses to start
    // the container without one of them.
    "NINJAONE_HTTP_AUTH": "entra",
    "NINJAONE_HTTP_ENTRA_TENANT_ID": "",
    "NINJAONE_HTTP_ENTRA_CLIENT_ID": "",
    "NINJAONE_HTTP_ENTRA_APP_ID_URI": "",
    "NINJAONE_HTTP_ENTRA_SCOPE": "mcp.access",
    "NINJAONE_HTTP_ENTRA_ROLE": "",

    // https://<worker>.<subdomain>.workers.dev or your custom domain, no path.
    "NINJAONE_HTTP_PUBLIC_URL": "",
    "NINJAONE_HTTP_ALLOWED_ORIGINS": ""
  }
}

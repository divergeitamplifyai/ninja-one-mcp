{
  "name": "ninja-one-mcp-cloudflare",
  "private": true,
  "description": "Cloudflare Workers and Containers deployment for ninja-one-mcp. See docs/CLOUDFLARE.md.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "wrangler types --include-env=false",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit",
    "test": "wrangler types --include-env=false && tsc && node --test test/*.test.mjs",
    "check": "wrangler deploy --dry-run --outdir build --containers-rollout=none",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "4.163.0"
  }
}

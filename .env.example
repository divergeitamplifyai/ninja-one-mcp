# Copy to .env for local runs, or set these in the MCP client configuration.
# Never commit a real value. For hosts that do not pass environment variables,
# put the same lines in ~/.config/ninja-one-mcp/.env and chmod 600 it.

# Required. From NinjaOne: Administration > Apps > API (API Services app,
# Client Credentials grant).
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=

# Required unless NINJAONE_BASE_URL is set: us (app.ninjarmm.com), us2, eu, ca, oc.
NINJAONE_REGION=

# Optional instance origin. Overrides the region. Must be https except loopback.
NINJAONE_BASE_URL=

# OAuth scopes to request (space or comma separated): monitoring, management, control.
# They must be granted to the API client. Default: monitoring (read only).
NINJAONE_SCOPES=monitoring

# Write gate: read (default) or write.
NINJAONE_MODE=read

# Second gate for the destructive tier. Needs NINJAONE_MODE=write as well.
NINJAONE_ALLOW_DESTRUCTIVE=false

# Optional: comma-separated write tool names. Every other write refuses.
NINJAONE_WRITE_ALLOWLIST=

# Optional hard boundary: comma-separated organization ids every call is held inside.
NINJAONE_ALLOWED_ORG_IDS=

# Optional default organization when a call omits org. The org argument always wins.
NINJAONE_ORG_ID=

# Toolsets to list: default, all, or a list such as default,billing.
NINJAONE_TOOLSETS=default

# Cross-organization fan-out concurrency, 1 to 16 (default 4).
NINJAONE_MAX_CONCURRENCY=4

# Credentials file path, or none to disable it.
NINJAONE_ENV_FILE=

# ---------------------------------------------------------------------------
# Remote HTTP transport (docs/AZURE.md). Only read with --http or
# NINJAONE_TRANSPORT=http. Off loopback, inbound auth is required.

# stdio (default) or http.
NINJAONE_TRANSPORT=

# Listener. Defaults: 127.0.0.1 and 8080 (or PORT).
NINJAONE_HTTP_HOST=
NINJAONE_HTTP_PORT=

# Public base URL, used in the OAuth protected resource metadata.
NINJAONE_HTTP_PUBLIC_URL=

# Inbound auth: none (loopback only), bearer or entra.
NINJAONE_HTTP_AUTH=

# bearer: comma-separated tokens of at least 32 characters.
NINJAONE_HTTP_BEARER_TOKENS=

# entra: tenant id, the MCP app registration's client id, optional App ID URI,
# required delegated scope (default mcp.access) and optional app role.
NINJAONE_HTTP_ENTRA_TENANT_ID=
NINJAONE_HTTP_ENTRA_CLIENT_ID=
NINJAONE_HTTP_ENTRA_APP_ID_URI=
NINJAONE_HTTP_ENTRA_SCOPE=
NINJAONE_HTTP_ENTRA_ROLE=

# Browser origins allowed to call the endpoint, comma separated.
NINJAONE_HTTP_ALLOWED_ORIGINS=

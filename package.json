{
  "name": "ninja-one-mcp",
  "version": "0.1.0",
  "description": "MCP server for the NinjaOne Public API v2: devices, organizations, patching, reports, ticketing, documentation and ITAM, read-only by default.",
  "private": false,
  "license": "MIT",
  "author": "Patrick King (https://github.com/patrickking67)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divergeitamplifyai/ninja-one-mcp.git"
  },
  "homepage": "https://github.com/divergeitamplifyai/ninja-one-mcp#readme",
  "bugs": "https://github.com/divergeitamplifyai/ninja-one-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ninjaone",
    "rmm",
    "claude",
    "codex",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "ninja-one-mcp": "bin/ninja-one-mcp.mjs"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "mutations.json",
    "README.md",
    "SECURITY.md",
    "llms.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "mcpServer": {
    "toolPrefix": "ninjaone",
    "envPrefix": "NINJAONE",
    "entry": "dist/index.js",
    "writeTools": "listed",
    "credentialEnv": [
      "NINJAONE_CLIENT_ID",
      "NINJAONE_CLIENT_SECRET"
    ],
    "baseUrlEnv": "NINJAONE_BASE_URL",
    "env": {
      "NINJAONE_TOOLSETS": "all",
      "NINJAONE_ENV_FILE": "none"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/http/main.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "conformance": "node scripts/check-conformance.mjs",
    "check:remote": "node scripts/check-remote.mjs",
    "coverage:spec": "npm run build && node scripts/spec-coverage.mjs",
    "gen:bodies": "node scripts/gen-bodies.mjs",
    "check": "npm run typecheck && node scripts/gen-bodies.mjs --check && node scripts/gen-app-runtime.mjs --check && node scripts/gen-docs.mjs --check && npm test && npm run conformance && node scripts/spec-coverage.mjs --check && node scripts/gen-catalog.mjs --check && node scripts/bundle.mjs --check && npm run check:remote",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "mutations": "node scripts/generate-mutations.mjs",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "gen:runtime": "node scripts/gen-app-runtime.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "bundle": "node scripts/bundle.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "gen": "node scripts/gen-docs.mjs && npm run build && node scripts/gen-bodies.mjs && node scripts/gen-app-runtime.mjs && npm run build && node scripts/gen-catalog.mjs && node scripts/spec-coverage.mjs && node scripts/bundle.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.160.0",
    "yaml": "2.9.1"
  }
}
